@inherits LayoutComponentBase

<header class="app-header">
    <div class="header-content">
        <NavLink href="/" class="brand" Match="NavLinkMatch.All">
            <span class="brand-mark">in</span>
            <span class="brand-name">Cursos</span>
        </NavLink>

        <nav class="header-nav" aria-label="Navegacao principal">
            <NavLink href="/" class="header-link" Match="NavLinkMatch.All">Inicio</NavLink>
            <NavLink href="/inscricao" class="header-link">Inscrever-se</NavLink>
        </nav>
    </div>
</header>

<main class="app-main">
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
